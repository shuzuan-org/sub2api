# =============================================================================
# Sub2API Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Alertmanager SMTP 授权码（明文，单行）
observability/alertmanager_smtp_password

# Prometheus 抓生产 /metrics 用的 Bearer Token（明文，单行）
observability/bearer_token.txt

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log
